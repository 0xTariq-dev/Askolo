modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[[deployment.responseHeaders]]
path = "/assets/*"
name = "Cache-Control"
value = "public, max-age=31536000, immutable"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "ai-credit-ledger"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test:ledger"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "artifacts/personal-assistant: web"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/personal-assistant"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/personal-assistant run dev"
cwd = "./artifacts/personal-assistant"
waitForPort = 18131
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "18131"
BASE_PATH = "/"

[[workflows.workflow]]
name = "artifacts/api-server: API Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "3B4_FFSkEVBkAeYMFRJ2e"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run dev"
cwd = "./artifacts/api-server"
waitForPort = 8080
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "8080"

[[workflows.workflow]]
name = "artifacts/mockup-sandbox: Component Preview Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "XegfDyZt7HqfW2Bb8Ghoy"
isCanvasWorkflow = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/mockup-sandbox run dev"
cwd = "./artifacts/mockup-sandbox"
waitForPort = 8081
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "8081"
BASE_PATH = "/__mockup"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "go-assemblyai-sidecar: compile"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "go-assemblyai-sidecar: run"

[[workflows.workflow]]
name = "go-assemblyai-sidecar: compile"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd services/assemblyai-sidecar && go test ./... && go vet ./... && mkdir -p bin && go build -trimpath -o ./bin/assemblyai-sidecar ./cmd/assemblyai-sidecar"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "go-assemblyai-sidecar: run"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd services/assemblyai-sidecar && go run ./cmd/assemblyai-sidecar"
waitForPort = 8090

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]

[userenv.development]
GOOGLE_REDIRECT_URI = "https://5b8af2fa-e65c-4295-8e4b-b5f0d0c10891-00-2sb81pwvhiesj.picard.replit.dev/api/google/gmail/callback"

[userenv.production]
GOOGLE_REDIRECT_URI = "https://askolo.replit.dev/api/google/gmail/callback"
VITE_CLERK_PROXY_URL = "/api/__clerk"

[nix]
channel = "stable-25_05"

