modules = ["nodejs-24", "python-base-3.13", "go-1.25", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[[deployment.responseHeaders]]
path = "/assets/*"
name = "Cache-Control"
value = "public, max-age=31536000, immutable"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "publish-paths"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run validate:publish-paths"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "submodules/Askolo-UI/artifacts/mockup-sandbox: Component Preview Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "XegfDyZt7HqfW2Bb8Ghoy"
isCanvasWorkflow = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/mockup-sandbox run dev"
cwd = "./submodules/Askolo-UI/artifacts/mockup-sandbox"
waitForPort = 8081
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "8081"
BASE_PATH = "/__mockup"

[[workflows.workflow]]
name = "submodules/Askolo-UI/artifacts/api-server: API Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "3B4_FFSkEVBkAeYMFRJ2e"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run dev"
cwd = "./submodules/Askolo-UI/artifacts/api-server"
waitForPort = 8080
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "8080"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
AUTH_EMAIL_FROM = "noreply@mail.askolo.app"
GOSUMDB = "sum.golang.org"

# This workspace is the development Repl. Staging and production use separate
# Replit projects and their own environment-specific resources.
[userenv.development]
ASKOLO_ENVIRONMENT = "development"
ASKOLO_COOKIE_NAMESPACE = "askolo_dev"
ASKOLO_DATABASE_ID = "development-database"
GOOGLE_REDIRECT_URI = "https://5b8af2fa-e65c-4295-8e4b-b5f0d0c10891-00-2sb81pwvhiesj.picard.replit.dev/api/google/gmail/callback"
ASKOLO_ADMIN_EMAILS = "tariqmohsen222@gmail.com"

[userenv.production]
ASKOLO_CANONICAL_ORIGIN = "https://dev.askolo.app"
ASKOLO_COMMIT_SHA = "1317b8f17ad7780405acd5a43eb4ff1f8096a6fb"
ASKOLO_COOKIE_NAMESPACE = "askolo_prod"
ASKOLO_DATABASE_ID = "production-database"
ASKOLO_ENVIRONMENT = "production"
ASKOLO_RELEASE_MODE = "normal"
ASKOLO_RELEASE_TAG = "1317b8f"

[nix]
channel = "stable-25_05"

