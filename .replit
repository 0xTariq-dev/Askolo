modules = ["nodejs-24", "python-base-3.13", "postgresql-16", "go-1.25"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[[deployment.responseHeaders]]
path = "/assets/*"
name = "Cache-Control"
value = "public, max-age=31536000, immutable"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "artifacts/personal-assistant: web"

[[workflows.workflow]]
name = "artifacts/personal-assistant: web"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/personal-assistant"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/personal-assistant run dev"
cwd = "./artifacts/personal-assistant"
waitForPort = 18131
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "18131"
BASE_PATH = "/"

[[workflows.workflow]]
name = "artifacts/mockup-sandbox: Component Preview Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "XegfDyZt7HqfW2Bb8Ghoy"
isCanvasWorkflow = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/mockup-sandbox run dev"
cwd = "./artifacts/mockup-sandbox"
waitForPort = 8081
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "8081"
BASE_PATH = "/__mockup"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]

[userenv.development]
ASKOLO_ENVIRONMENT = "development"
ASKOLO_COOKIE_NAMESPACE = "askolo_dev"
ASKOLO_DATABASE_ID = "development-database"
GOOGLE_REDIRECT_URI = "https://5b8af2fa-e65c-4295-8e4b-b5f0d0c10891-00-2sb81pwvhiesj.picard.replit.dev/api/google/gmail/callback"

[userenv.production]
VITE_CLERK_PROXY_URL = "/api/__clerk"
ASKOLO_CANONICAL_ORIGIN = "https://dev.askolo.app"
ASKOLO_COMMIT_SHA = "1317b8f17ad7780405acd5a43eb4ff1f8096a6fb"
ASKOLO_COOKIE_NAMESPACE = "askolo_prod"
ASKOLO_DATABASE_ID = "production-database"
ASKOLO_ENVIRONMENT = "production"
ASKOLO_RELEASE_MODE = "normal"
ASKOLO_RELEASE_TAG = "1317b8f"

[nix]
channel = "stable-25_05"

